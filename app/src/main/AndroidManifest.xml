<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />


    <application
        android:name=".VollaHubApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_vollahub_pictogram_dark_02"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_vollahub_pictogram_dark_02_round"
        android:theme="@style/Theme.VollaHub"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.volla.hub.StartActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.volla.hub.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.volla.hub.ContentActivity"
            android:exported="false"
            android:parentActivityName="com.volla.hub.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name="com.volla.hub.DeviceReportActivity"
            android:exported="false"
            android:label="Geräte-Report"
            android:parentActivityName="com.volla.hub.MainActivity" />

        <activity
            android:name="com.volla.hub.ReportHistoryActivity"
            android:exported="false"
            android:label="Bericht-Historie"
            android:parentActivityName="com.volla.hub.DeviceReportActivity" />

        <activity
            android:name="com.volla.hub.ChatBotActivity"
            android:exported="false"
            android:label="HelpBot"
            android:parentActivityName="com.volla.hub.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.volla.hub.LocationShareActivity"
            android:exported="false"
            android:label="Ortung"
            android:parentActivityName="com.volla.hub.StartActivity" />

        <activity
            android:name="com.volla.hub.ScreenshotActivity"
            android:exported="false"
            android:label="@string/btn_screenshot"
            android:parentActivityName="com.volla.hub.StartActivity" />

        <activity
            android:name="com.volla.hub.SimpleScreenshotActivity"
            android:exported="false"
            android:label="@string/btn_simple_screenshot"
            android:theme="@style/Theme.VollaHub.Translucent"
            android:parentActivityName="com.volla.hub.StartActivity" />

        <activity
            android:name="com.volla.hub.StorageAnalysisActivity"
            android:exported="false"
            android:label="Speicher-Analyse"
            android:parentActivityName="com.volla.hub.MainActivity" />

        <service
            android:name="com.volla.hub.ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name="com.volla.hub.SimpleScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name="com.volla.hub.ScrollingScreenshotService"
            android:exported="true"
            android:label="VollaHub Scroll-Dienst"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name="com.volla.hub.LocationShareService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          Wird von androidx.appcompat für den Per-App-Sprache-Backport auf
          Android-Versionen unter API 33 benötigt (LocaleManager gibt es erst
          ab API 33 nativ). Der Service läuft nie wirklich, er dient nur als
          Marker, damit AppCompat die zuletzt gesetzte Sprache über einen
          Prozess-Neustart hinweg zuverlässig wiederherstellen kann, bevor
          VollaHubApp.onCreate() läuft.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>